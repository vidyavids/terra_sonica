{
  "provenance": {
    "dataset": "Monthly counts of MODIS active-fire detections over Brazil, NASA FIRMS API (product MODIS_SP, area query), masked to the GADM 4.1 Brazil level-0 boundary (accessed Nov 2026). Counts are detection observations, not unique wildfires or area burned.",
    "visual": "Fires in Greece, MODIS on Aqua, 22 Aug 2009. Credit: NASA Earth Observatory image by Jeff Schmaltz, MODIS Rapid Response Team, NASA GSFC.",
    "visualCoverage": "Fires in Greece, Aug 2009 (single MODIS still). The visual is contextual, not synchronized with the sound.",
    "soundCoverage": "Jan 2020-Dec 2025 monthly (72 months).",
    "sourceFile": "fire-brazil-monthly-2020-2025.csv",
    "fetchLog": "fire-brazil-fetch-log.json",
    "column": "count (monthly MODIS active-fire detections, integer)",
    "referencePeriod": "n/a (raw detection counts, no baseline).",
    "satelliteCheck": "Terra and Aqua both present in all 72 months; no sensor dropout.",
    "region": "Brazil, GADM 4.1 level-0 dissolved polygon (bbox approx -74,-34,-28,6).",
    "eventCount": 72,
    "missingValuePolicy": "No month is missing. Missing months would fail validation, never be interpolated or zero-filled.",
    "generatedBy": "scripts/validate_fire.py",
    "mappingDoc": "docs/fire-mapping.md"
  },
  "mapping": {
    "linearHz": "clamp(C, 2914, 164682); 220 + (C - 2914) / (164682 - 2914) * 660",
    "quantization": "nearest E-natural-minor note by ABS(LOG(raw/note, 2)); ties resolve to the higher note; raw frequencies clamp to [E3, B5].",
